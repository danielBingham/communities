# =============================================================================
#  Communities — local configuration
# =============================================================================
#  Copy this file to `.env` in the repository root and fill in the three
#  secrets marked below:
#
#    cp .env.local.example .env
#
#  These are the values for the development configuration that reads from
#  environment variables. Create it for each app by copying the example:
#
#    cp worker/config/index.development.js-env-example \
#       worker/config/index.development.js
#    cp web-application/server/config/index.development.js-env-example \
#       web-application/server/config/index.development.js
#
#  A variable here is only used if index.development.js names it with `env:`.
#  Each one is the Parameter Store path in constant case, prefixed with
#  COMMUNITIES_: /database/host is COMMUNITIES_DATABASE_HOST.
#
#  If you use index.development.js-ssm-example instead, you only need
#  COMMUNITIES_ENVIRONMENT_NAME (your Parameter Store path, e.g.
#  local/<username>), COMMUNITIES_LOG_LEVEL and AWS credentials here.
#
#  Docker Compose reads this file and passes it to the worker and
#  web-application containers. Running on bare metal (`npm run dev`), both
#  apps load it themselves in development.
# =============================================================================

# --- Environment --------------------------------------------------------------
# The Parameter Store path prefix for `aws-ssm-parameter:` values (unused by
# the environment-variable example), and the log level.
COMMUNITIES_ENVIRONMENT_NAME=local
COMMUNITIES_LOG_LEVEL=debug

# --- Server -------------------------------------------------------------------
# Where the browser reaches the app: the webpack dev server, which proxies the
# API and WebSocket to the server on port 8080.
COMMUNITIES_HOST=https://localhost:3000
COMMUNITIES_WS_HOST=wss://localhost:3000

# --- Database -----------------------------------------------------------------
# The postgres service in compose.yaml, created by
# database/initialization-scripts. On bare metal, use localhost.
COMMUNITIES_DATABASE_HOST=postgres
COMMUNITIES_DATABASE_PORT=5432
COMMUNITIES_DATABASE_USER=app
COMMUNITIES_DATABASE_PASSWORD=local-development
COMMUNITIES_DATABASE_NAME=communities

# --- Redis --------------------------------------------------------------------
# The redis service in compose.yaml. On bare metal, use localhost.
COMMUNITIES_REDIS_HOST=redis
COMMUNITIES_REDIS_PORT=6379

# --- Sessions -----------------------------------------------------------------
# The header names must match the ones the client sends.
COMMUNITIES_SESSION_COOKIE_NAME=communities.sid
COMMUNITIES_SESSION_HEADER_NAME=X-Communities-Auth
COMMUNITIES_SESSION_PLATFORM_HEADER=X-Communities-Platform
# Secret 1 of 3. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COMMUNITIES_SESSION_SECRET=

# --- Multi-factor authentication ------------------------------------------------
# Encrypts users' MFA secrets with AES-256-GCM.
# Secret 2 of 3: a 32-byte key, hex encoded. Generate one with the same command.
COMMUNITIES_ENCRYPTION_MFA_V1_KEY=
COMMUNITIES_ENCRYPTION_MFA_V1_ALGORITHM=aes-256-gcm
COMMUNITIES_ENCRYPTION_MFA_V1_KEY_LENGTH=32
COMMUNITIES_ENCRYPTION_MFA_V1_AUTH_TAG_LENGTH=16
COMMUNITIES_ENCRYPTION_MFA_V1_INITIALIZATION_VECTOR_LENGTH=12
COMMUNITIES_ENCRYPTION_MFA_V1_SALT_LENGTH=16

# --- File storage -------------------------------------------------------------
# The environment-variable example config uses the filesystem storage driver,
# which keeps uploads in local-data/storage and serves them from signed links.
# Secret 3 of 3: signs those links. Generate one with the same command.
COMMUNITIES_STORAGE_FILESYSTEM_SECRET=

# --- Not available locally yet ------------------------------------------------
# Push notifications (APNs and Firebase) don't have a local replacement yet.
# These placeholders let both apps start; notification jobs fail until the
# local push driver lands. If you have real credentials, put them here
# instead. (Email needs nothing here: the environment-variable example config
# uses the log email driver.)
COMMUNITIES_NOTIFICATIONS_IOS_APNS_PRIVATE_KEY_PEM=not-configured
COMMUNITIES_NOTIFICATIONS_IOS_APNS_PUBLIC_CERT_PEM=not-configured
COMMUNITIES_NOTIFICATIONS_IOS_APPLICATION_BUNDLE_ID=social.communities
COMMUNITIES_NOTIFICATIONS_IOS_ENDPOINT=https://api.sandbox.push.apple.com
COMMUNITIES_NOTIFICATIONS_ANDROID_FIREBASE_SERVICE_ACCOUNT_JSON={}
