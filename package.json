{
  "name": "communities",
  "version": "0.23.0",
  "description": "Root package for Communities",
  "author": "Daniel Bingham",
  "license": "GPL-3.0",
  "private": true,
  "engines": {
    "node": ">=24.5.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/session",
    "worker",
    "web-application"
  ],
  "scripts": {
    "build": "export NODE_ENV=production && npm run build -w web-application && npx cap sync",
    "build-staging": "export NODE_ENV=staging && npm run build -w web-application && npx cap sync",
    "build-dev": "export NODE_ENV=development && npm run build-dev -w web-application && npx cap sync",
    "dev": "export NODE_ENV=development && concurrently \"npm run dev -w worker\" \"npm run dev -w web-application\"",
    "test": "npm test -w packages/shared -w packages/backend -w web-application",
    "test:integration": "npm run test:integration -w web-application",
    "test:integration:staging": "npm run test:integration:staging -w web-application",
    "check:lockfile": "node scripts/check-lockfile.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/app": "^7.1.0",
    "@capacitor/cli": "^7.4.2",
    "@capacitor/clipboard": "^7.0.4",
    "@capacitor/core": "^7.4.2",
    "@capacitor/device": "^7.0.2",
    "@capacitor/ios": "^7.4.2",
    "@capacitor/push-notifications": "^7.0.6",
    "@capacitor/status-bar": "^7.0.3",
    "@capacitor/text-zoom": "^7.0.4",
    "@capawesome/capacitor-badge": "^7.0.1",
    "@capgo/capacitor-updater": "7.8.7",
    "capacitor-secure-storage-plugin": "^0.11.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "concurrently": "^9.2.1"
  }
}
