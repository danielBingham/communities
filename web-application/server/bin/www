#!/usr/bin/env node

console.log('Beginning server bootstrapping...')

const { createCore } = require('../core')
const { createSessionParser } = require('../session')
const { createExpressApp } = require('../app')
const { createHTTPServer, createPlainHTTPServer, PLAIN_HTTP_PORT } = require('../httpServer')
const { createWebSocketServer } = require('../wsServer')
const { createEventHandlers } = require('../events')

/**
 * Normalize a port into a number, string, or false.
 */
const normalizePort = function(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

createCore('web-application').then(function(core) {
  const sessionParser = createSessionParser(core)
  const app = createExpressApp(core, sessionParser)
  const server = createHTTPServer(core, app)
  const webSocketServer = createWebSocketServer(core, sessionParser, server)
  const eventHandlers = createEventHandlers(core)

  // TRANSITIONAL (feat-7-tls-everywhere): plain HTTP too, with its own
  // WebSocket handling, until the load balancer has moved to HTTPS. See
  // createPlainHTTPServer().
  const plainServer = createPlainHTTPServer(core, app)
  createWebSocketServer(core, sessionParser, plainServer)

  /**
   * Handle server shutdown
   */
  const shutdownServer = function() {
    core.logger.info('Attempting a graceful shutdown...')
    // Close the servers so we stop taking new connections before we close
    // down the resources needed to process those connections.
    const closed = [ server, plainServer ].map(
      (toClose) => new Promise((resolve) => toClose.close(() => resolve()))
    )
    Promise.all(closed).then(async function() {
      // Now close down the resources needed to process the http connections.
      await core.shutdown()

      core.logger.info('Shutdown complete.')
      process.exit(0)
    })
  }
  process.on('SIGTERM', shutdownServer)
  process.on('SIGINT', shutdownServer)

  /**
   * Get port from environment and store in Express.
   */
  var port = normalizePort(process.env.PORT || '8443');
  app.set('port', port);

  /**
   * Listen on provided port, on all network interfaces.
   */
  core.logger.info(`Starting up the HTTPS server:
    host: ${core.config.host}
    port: ${port}.
    version: ${process.env.npm_package_version}
  `)
  server.listen(port);
  plainServer.listen(PLAIN_HTTP_PORT);
})
