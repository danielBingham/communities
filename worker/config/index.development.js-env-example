/**************************************************************************************************
 *          Configuration: development, from environment variables (example)
 *
 * To use it, copy it to index.development.js in this folder (git ignores that
 * file), then edit your copy as you like. index.development.js is loaded when
 * NODE_ENV=development (see index.js).
 *
 * This example reads values from environment variables, so you don't need an
 * AWS account, and uses the log email driver, so no email is sent: each one is
 * logged and saved under tmp/email instead. .env.local.example in the
 * repository root lists the variables with working local values. Each variable is the Parameter Store
 * path in constant case, prefixed with COMMUNITIES_: /database/host is
 * COMMUNITIES_DATABASE_HOST.
 *
 * Every string value declares where it comes from:
 *
 *   'aws-ssm-parameter:/path'  AWS Parameter Store, at /$COMMUNITIES_ENVIRONMENT_NAME/path
 *   'env:VARIABLE'             the environment variable VARIABLE
 *   anything else              used as written
 *
 * Nothing is read from the environment unless this file says `env:` for it.
 **************************************************************************************************/

module.exports = {
    host: 'env:COMMUNITIES_HOST',
    wsHost: 'env:COMMUNITIES_WS_HOST',
    environment: 'development',
    environmentName: 'env:COMMUNITIES_ENVIRONMENT_NAME',
    log_level: 'env:COMMUNITIES_LOG_LEVEL',
    // Database configuration
    database: {
        host: 'env:COMMUNITIES_DATABASE_HOST',
        port: 'env:COMMUNITIES_DATABASE_PORT',
        user: 'env:COMMUNITIES_DATABASE_USER',
        password: 'env:COMMUNITIES_DATABASE_PASSWORD',
        name: 'env:COMMUNITIES_DATABASE_NAME'
    },
    redis: {
        host: 'env:COMMUNITIES_REDIS_HOST',
        port: 'env:COMMUNITIES_REDIS_PORT'
    },
    session: {
        cookieName: 'env:COMMUNITIES_SESSION_COOKIE_NAME',
        headerName: 'env:COMMUNITIES_SESSION_HEADER_NAME',
        platformHeader: 'env:COMMUNITIES_SESSION_PLATFORM_HEADER',
        secret: 'env:COMMUNITIES_SESSION_SECRET'
    },
    // Storage: `driver` selects where uploaded files are kept, and the block
    // with the same name configures that driver (see
    // packages/backend/services/storage). The filesystem driver keeps files
    // under `directory` (relative to the app's folder, so both apps share
    // local-data/storage at the repository root) and serves them to browsers
    // from links signed with `secret`. To use S3, or an S3-compatible server,
    // use `driver: 's3'` with an `s3: { ... }` block instead.
    storage: {
        driver: 'filesystem',
        filesystem: {
            directory: '../local-data/storage',
            secret: 'env:COMMUNITIES_STORAGE_FILESYSTEM_SECRET'
        }
    },
    // Email: `driver` selects how email is sent, and the block with the same
    // name configures that driver (see packages/backend/services/email). The
    // log driver sends nothing: it logs each message and, with `directory`,
    // writes it there as JSON. To send through Postmark instead, use
    // `driver: 'postmark'` with a `postmark: { api_token: ... }` block.
    email: {
        driver: 'log',
        log: {
            directory: 'tmp/email'
        }
    },
    notifications: {
        ios: {
            privateCert: 'env:COMMUNITIES_NOTIFICATIONS_IOS_APNS_PRIVATE_KEY_PEM',
            publicCert: 'env:COMMUNITIES_NOTIFICATIONS_IOS_APNS_PUBLIC_CERT_PEM',
            applicationBundleID: 'env:COMMUNITIES_NOTIFICATIONS_IOS_APPLICATION_BUNDLE_ID',
            endpoint: 'env:COMMUNITIES_NOTIFICATIONS_IOS_ENDPOINT'
        },
        android: {
            firebaseServiceAccount: 'env:COMMUNITIES_NOTIFICATIONS_ANDROID_FIREBASE_SERVICE_ACCOUNT_JSON'
        }
    }
}
